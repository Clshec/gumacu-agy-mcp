[Unit]
Description=Alf Control direct MCP readiness (legacy unit name)
After=network-online.target gumacu-ssh-mcp.service
Wants=network-online.target gumacu-ssh-mcp.service

[Service]
Type=oneshot
ExecStart=/opt/gumacu-agy-mcp/venv/bin/alf-control-doctor
RemainAfterExit=yes
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
